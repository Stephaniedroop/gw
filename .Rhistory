# Now get cohens k
get_kappa <- function(matrix) {
stopifnot("input must be single matrix" = is.matrix(matrix))
diags <- diag(matrix)
N <- sum(matrix)
row.marginal.props <- rowSums(matrix) / N
col.marginal.props <- colSums(matrix) / N
# Compute kappa
Po <- sum(diags) / N
Pe <- sum(row.marginal.props * col.marginal.props)
k <- (Po - Pe) / (1 - Pe)
}
