library(here)
library(tidyverse)
set.seed(1)
n <- 500
g <- rnorm(n, 0.02, 0.06)                    # true store-level growth
closed <- g < quantile(g, 0.08)              # worst 8% shut
rev_prior <- rlnorm(n, 13, 0.4)
total  <- sum(rev_prior * (1 + g) * !closed) / sum(rev_prior) - 1
lfl    <- weighted.mean(g[!closed], rev_prior[!closed])
c(reported_LFL = lfl, actual_total = total, gap_bps = (lfl - total) * 1e4)
?rnorm
?quantile
?rlnorm
print(closed==TRUE)
true <- closed |> filter(closed == TRUE) |> pull(closed)
true <- closed == TRUE |> pull(closed)
true <- closed == TRUE
true <- which(closed == TRUE)
# return the values of g for the closed stores
closed_values <- g[true]
closed_values
max_closed_value <- max(closed_values)
min_closed_value <- min(closed_values) # -0.187
load(here('Exp2Explanation', 'Model', 'Data', 'modelDataSimple.rda')) # from getPreds.R: food_preds and path_preds, each 512 of 32
# Also uses a var, uvar, defined in semUtilsSimple, but set it again here
uvars <- c(
"Pu",
"Ku",
"Cu",
"Su",
"br"
)
# Put node names from col to in a col. 4608 of 25
pathlong <- path_preds |>
pivot_longer(
cols = c(Pces:brces),
names_to = c('node', '.value'),
names_sep = -3
)
# 4608 of 15
pathlong <- pathlong |>
select(-(Pcfs:E_count))
# Node and value together for labelling
pathlong$node3 <- apply(pathlong, 1, function(r) {
paste0(r["node"], "=", r[r["node"]])
})
# Put node names from col to in a col. 4608 of 25
foodlong <- food_preds |>
pivot_longer(
cols = c(Pces:brces),
names_to = c('node', '.value'),
names_sep = -3
)
# 4608 of 15
foodlong <- foodlong |>
select(-(Pcfs:E_count))
# Node and value together for labelling
foodlong$node3 <- apply(foodlong, 1, function(r) {
paste0(r["node"], "=", r[r["node"]])
})
# A variable which is paste0 the value of all uvars in that row, eg 00000
# This is needed for the normalisation step, otherwise each ces score is made of 16 different ones - check with Neil
pathlong$uvars <- apply(pathlong, 1, function(r) {
paste0(r[uvars], collapse = "")
})
foodlong$uvars <- apply(foodlong, 1, function(r) {
paste0(r[uvars], collapse = "")
})
path_S_hat <- pathlong |>
group_by(condition, uvars) |>
mutate(s_hat = exp(ces / .25) / sum(exp(ces / .25))) |>
ungroup()
food_S_hat <- foodlong |>
group_by(condition, uvars) |>
mutate(s_hat = exp(ces / .25) / sum(exp(ces / .25))) |>
ungroup()
path_ces <- path_S_hat |>
group_by(condition, sem, node3) |>
summarise(postces = sum(posterior * s_hat)) |>
ungroup()
food_ces <- food_S_hat |>
group_by(condition, sem, node3) |>
summarise(postces = sum(posterior * s_hat)) |>
ungroup()
View(path_ces)
path_ces <- path_ces |>
group_by(condition) |>
mutate(postces_norm = postces / sum(postces)) |>
ungroup()
food_ces <- food_ces |>
group_by(condition) |>
mutate(postces_norm = postces / sum(postces)) |>
ungroup()
# How many rows are in each condition?
pc <- path_ces |>
group_by(condition) |>
summarise(n = n()) |>
ungroup()
View(pc)
fc <- food_ces |>
group_by(condition) |>
summarise(n = n()) |>
ungroup()
View(food_ces)
View(fc)
View(fc)
# Now count how many times each N occurs
pcc <- pc |>
group_by(n) |>
summarise(n = n()) |>
ungroup()
View(pcc)
# Now count how many times each N occurs
pcc <- pc |>
group_by(n) |>
summarise(count = n()) |>
ungroup()
View(pcc)
fcc <- fc |>
group_by(n) |>
summarise(count = n()) |>
ungroup()
View(fcc)
View(food_S_hat)
View(foodlong)
View(fcc)
View(fc)
