# ------ this if we do split out br --------
# What about br?
df_fixed <- df_fixed |>
mutate(
State = case_when(
grepl("^br", node3, ignore.case = TRUE) ~ "br",
grepl("^[a-zA-Z]=", node3) ~ "Obs",
TRUE ~ "UnObs"
)
)
quicp <- df_fixed |>
mutate(State = factor(State, levels = c("Obs", "UnObs", "br"))) |>
ggplot(aes(x = State)) +
geom_bar() +
labs(
title = "Counts of Observed vs Unobserved Explanations",
x = "State Type",
y = "Count"
) +
theme_classic()
